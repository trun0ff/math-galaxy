static func configure(material: ShaderMaterial, species: int) -> void:
	material.set_shader_parameter("mouth_region", PARTS[species][0])
	for index in range(8):
		material.set_shader_parameter("part_%d" % index, PARTS[species][index + 1] if index + 1 < PARTS[species].size() else Vector4.ZERO)
	for index in range(6):
		material.set_shader_parameter("eye_%d" % index, EYES[species][index] if index < EYES[species].size() else Vector4.ZERO)

static func regions_for(species: int) -> Array:
	return PARTS[species] + EYES[species]
