extends SceneTree
const BATTLE = preload("res://scripts/SpaceScene.gd")
class TestMain extends "res://scripts/Main.gd":
	func save_progress() -> void: pass
var impact_count := 0
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var battle := Control.new()
	battle.set_script(BATTLE)
	battle.size = Vector2(1100, 220)
	root.add_child(battle)
	battle.set_process(false)
	battle.ship_impact.connect(func(): impact_count += 1)
	for world in [1, 2, 3]:
		battle.set_world(world)
		battle.hit_ship()
		assert(battle.enemy_shot_color == battle.ENEMY_COLORS[world-1])
		assert(battle.damage_timer == 0 and impact_count == world-1)
		battle._process(0.2)
		assert(battle.enemy_attack_timer > 0 and battle.damage_timer == 0)
		battle._process(0.17)
		assert(impact_count == world and battle.damage_timer > 0)
		battle._process(1.2)
	battle.hit_ship()
	battle.destroy_ship()
	assert(battle.pending_destruction and battle.death_timer == 0)
	battle._process(0.37)
	assert(battle.death_timer > 0 and not battle.pending_destruction)
	assert(battle.retreating and battle.ship_actor.visible)
	var departure_x: float = battle.ship_position().x
	battle._process(0.6)
	assert(battle.ship_position().x < departure_x)
	battle._process(0.6)
	assert(not battle.ship_actor.visible)
	battle.free()
	for variant in range(3):
		var weapon := Control.new()
		weapon.set_script(BATTLE)
		weapon.size = Vector2(1100, 220)
		root.add_child(weapon)
		weapon.set_process(false)
		weapon.ship_variant = variant
		weapon.hit_enemy()
		assert(weapon.enemy_hp == 2 and weapon.display_hp == 3)
		assert(weapon.weapon_mode == weapon.WEAPONS[variant])
		assert(weapon.shot_color == weapon.SHIP_COLORS[variant])
		weapon._process(weapon.shot_arrival - 0.01)
		assert(weapon.display_hp == 3 and weapon.pending_enemy_hit)
		weapon._process(0.02)
		assert(weapon.display_hp == 2 and not weapon.pending_enemy_hit)
		weapon.free()
	var host := TestMain.new()
	root.add_child(host)
	host.set_process(false)
	host.start_mission()
	host.art.set_process(false)
	host.resolve_answer(-1, "skip")
	assert(host.shield == 80 and host.shield_bar.value == 100)
	host.art._process(0.2)
	assert(host.shield_bar.value == 100)
	host.art._process(0.17)
	assert(host.shield_bar.value == 80)
	host.free()
	print("Battle attack timing and animation tests passed")
	quit()
