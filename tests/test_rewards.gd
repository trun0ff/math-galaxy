extends SceneTree
const R = preload("res://scripts/RewardManager.gd")
const DATA = preload("res://scripts/ParentData.gd")
func _initialize() -> void:
	var p := {"coins": 179, "skills": {}, "missions": 4}
	R.migrate(p)
	assert(p.coins == 179 and p.missions == 4 and DATA.validate(p))
	assert(not R.purchase(p, "violet"))
	assert(p.coins == 179)
	p.coins = 1500
	assert(R.purchase(p, "violet"))
	assert(p.coins == 300)
	assert(not R.purchase(p, "violet"))
	assert(not R.purchase(p, "unknown"))
	assert(not R.equip(p, "gold"))
	assert(R.equip(p, "violet"))
	var skills: Dictionary = p.skills.duplicate(true)
	var award := R.settle(p, 1, true, 9, 1, 100, 1, "2026-10-29", 1)
	assert(award.amount == 270)
	var balance: int = p.coins
	assert(R.settle(p, 1, true, 9, 1, 100, 1, "2026-10-29", 1).amount == 0)
	assert(R.settle(p, 2, false, 20, 0, 300, 1, "2026-10-30", 1).amount == 0)
	assert(p.coins == balance and p.rewards.days.size() == 1)
	assert(p.rewards.achievements.has("accurate"))
	assert(R.settle(p, 2, true, 20, 0, 300, 1, "2026-10-30", 1).amount == 0)
	var restored: Dictionary = JSON.parse_string(JSON.stringify(p))
	R.migrate(restored)
	assert(DATA.validate(restored))
	assert(R.settle(restored, 1, true, 20, 0, 300, 1, "2026-10-30", 1).amount == 0)
	assert(R.settle(restored, 3, true, 10, 0, 100, 0, "2026-10-30", 1).amount == 225)
	R.settle(restored, 4, true, 1, 0, 10, 0, "2026-10-31", 1)
	assert(restored.rewards.achievements.has("return"))
	assert(restored.skills == skills)
	assert(DATA.write_save("user://reward_test.json", restored))
	var disk: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("user://reward_test.json"))
	assert(disk.coins == restored.coins)
	assert(R.settle(disk, 4, true, 1, 0, 10, 0, "2026-10-31", 1).amount == 0)
	DirAccess.remove_absolute("user://reward_test.json")
	print("Reward tests passed")
	quit()
